# Partner 环境配置模板:复制为 .env 后填入真实值
# DeepSeek API Key(必填):https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 服务端口
PORT=8000
# Partner 动手操作的工作区白名单(多个目录用英文分号分隔)
# 设成 C:/;D:/ 即整机放开;不配默认只允许 AI_agent 目录
WORKSPACE_DIRS=D:/AI_agent
# 访问密码(服务开在局域网,必须设置;手机浏览器打开时要输入)
ACCESS_KEY=改成你自己的密码
# 可选:本地视觉模型,让 Partner 能"看"图片画面(不只是 OCR 文字)
# 启用方法:先 ollama pull llava,再取消下面注释填模型名
# VISION_MODEL=llava
# 可选:微信推送 token(https://www.pushplus.plus 扫码注册获得)
# 填了之后,后台任务完成时微信会收到"蓝蓝:任务完成"通知
# PUSHPLUS_TOKEN=你的token
# 可选:企业微信推送(work.weixin.qq.com 管理后台获取)
# WECOM_CORP_ID=ww开头企业ID
# WECOM_AGENT_ID=自建应用AgentId
# WECOM_SECRET=自建应用Secret
